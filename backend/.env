# --- BACKEND CONFIGURATION ---
COPERNICUS_API_KEY=your_key_here
WORLDPOP_API_KEY=your_key_here
# Update DATABASE_URL to use the 'db' service name if you add a database container later
DATABASE_URL=postgresql://user:password@localhost/urban_growth
DEBUG=True
GROWTH_DATA_PATH=../urban-growth-mock-data/export/synthetic_growth_data.json

# --- FRONTEND CONFIGURATION ---
# The browser will use this URL relative to its own domain (localhost:3000)
# Next.js rewrites will proxy this to the backend service
NEXT_PUBLIC_API_URL=/api/v1

# --- DOCKER CONFIGURATION ---
BACKEND_SERVICE_URL=http://backend:8001
