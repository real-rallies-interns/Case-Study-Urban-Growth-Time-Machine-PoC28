'use client';

import { MapContainer, TileLayer, CircleMarker, Popup, useMap } from 'react-leaflet';
import 'leaflet/dist/leaflet.css';
import L from 'leaflet';
import { useEffect, useState } from 'react';

// Fix for default marker icons
import icon from 'leaflet/dist/images/marker-icon.png';
import iconShadow from 'leaflet/dist/images/marker-shadow.png';

let DefaultIcon = L.icon({
    iconUrl: icon.src,
    shadowUrl: iconShadow.src,
    iconSize: [25, 41],
    iconAnchor: [12, 41]
});

L.Marker.prototype.options.icon = DefaultIcon;

interface MapProps {
    filter: string;
    mode: 'BEFORE' | 'AFTER';
}

export default function MapComponent({ filter, mode }: MapProps) {
  const position: [number, number] = [12.9716, 77.5946];
  
  // SECTION 3: PHASE 1 FEATURES - Before/After Logic
  // 2018 (Before) vs 2023 (After)
  const markers = [
    { id: 1, pos: [12.9716, 77.5946], type: 'LIVE', name: 'URBAN_CORE', year: 2018, density: '8,400/km²', color: '#10b981', area: 20 },
    { id: 2, pos: [12.9716, 77.5946], type: 'LIVE', name: 'URBAN_CORE', year: 2023, density: '12,400/km²', color: '#10b981', area: 35 },
    { id: 3, pos: [12.9816, 77.6046], type: 'PILOT', name: 'GROWTH_SECTOR_A', year: 2018, density: '1,200/km²', color: '#38bdf8', area: 5 },
    { id: 4, pos: [12.9816, 77.6046], type: 'PILOT', name: 'GROWTH_SECTOR_A', year: 2023, density: '4,200/km²', color: '#38bdf8', area: 25 },
    { id: 5, pos: [12.9616, 77.5846], type: 'PLANNED', name: 'FUTURE_CORRIDOR_X', year: 2023, density: '800/km²', color: '#f59e0b', area: 10 }
  ];

  const currentYear = mode === 'BEFORE' ? 2018 : 2023;

  const filteredMarkers = markers.filter(m => {
    const isYearMatch = m.year === currentYear;
    const isFilterMatch = filter === 'ALL_RAILS' || m.type === filter;
    return isYearMatch && isFilterMatch;
  });

  return (
    <div className="w-full h-full relative">
      <MapContainer 
        center={position} 
        zoom={13} 
        scrollWheelZoom={false} 
        style={{ height: '100%', width: '100%', background: '#030712' }}
      >
        <TileLayer
          attribution='&copy; CARTO'
          url="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
        />
        
        {/* Heatmap Simulation via Scaled Circles */}
        {filteredMarkers.map(marker => (
            <CircleMarker 
                key={marker.id}
                center={marker.pos as [number, number]} 
                pathOptions={{ 
                    color: marker.color, 
                    fillColor: marker.color, 
                    fillOpacity: mode === 'AFTER' ? 0.6 : 0.4,
                    weight: 2
                }} 
                radius={marker.area * 2}
            >
                <Popup>
                    <div className="text-xs font-mono bg-[#0B1117] text-white p-2 border border-[#1F2937]">
                        <p className="font-bold uppercase" style={{ color: marker.color }}>{marker.name} // {marker.year}</p>
                        <p className="mt-1 text-[10px] text-slate-400">DENSITY: {marker.density}</p>
                        <p className="text-[10px] text-slate-400 uppercase">STATUS: {marker.type}</p>
                    </div>
                </Popup>
            </CircleMarker>
        ))}
      </MapContainer>
      
      {/* Visual Indicator Overlay */}
      <div className="absolute top-4 right-4 z-[1000] glass-panel px-3 py-1 text-[10px] font-mono text-accent-primary border-accent-primary/20">
         VIEW: {mode} // YEAR: {currentYear}
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/lib/api.ts">
const API_BASE_URL = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8000/api/v1';

export async function fetchGrowthMetrics(aoiId: string) {
  try {
    const response = await fetch(`${API_BASE_URL}/growth/${aoiId}`);
    if (!response.ok) throw new Error('API_UNAVAILABLE');
    return await response.json();
  } catch (error) {
    // SECTION 5: MOCK FALLBACK SYSTEM
    console.warn('Real Rails Protocol: Falling back to local mock_data.json');
    try {
        const fallback = await fetch('/mock_data.json');
        return await fallback.json();
    } catch (innerError) {
        return {
            aoi_id: "critical_fallback",
            time_window: "ERROR",
            metrics: [],
            geojson_url: "",
            insight: "SYSTEM_FAILURE: No data available.",
            intelligence_score: 0
        };
    }
  }
}

export async function saveAOI(aoiData: any) {
  try {
    const response = await fetch(`${API_BASE_URL}/aoi`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(aoiData)
    });
    return await response.json();
  } catch (error) {
    // Fallback to LocalStorage for AOI Save
    const existing = JSON.parse(localStorage.getItem('saved_aois') || '[]');
    const newAoi = { ...aoiData, id: Math.random().toString(36).substr(2, 9), created_at: new Date().toISOString() };
    localStorage.setItem('saved_aois', JSON.stringify([...existing, newAoi]));
    return newAoi;
  }
}
